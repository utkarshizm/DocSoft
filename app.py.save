"""
AI Document Q&A System — RAG Pipeline
--------------------------------------
Upload PDFs, ask questions, get answers grounded in the source text
with page-level citations.

Stack: LangChain + ChromaDB + Google Gemini (embeddings + LLM) + Streamlit

Run:
    streamlit run app.py
from langchain_text_splitters import RecursiveCharacterTextSplitter"""

import os
import tempfile
import streamlit as st

from langchain_community.document_loaders import PyPDFLoader
from langchain_community.vectorstores import Chroma
from langchain_google_genai import GoogleGenerativeAIEmbeddings, ChatGoogleGenerativeAI
from langchain.chains import RetrievalQA
from langchain.prompts import PromptTemplate


# --------------------------------------------------------------------------
# Page config
# --------------------------------------------------------------------------
st.set_page_config(page_title="AI Document Q&A (RAG)", page_icon="📄", layout="wide")
st.title("📄 AI Document Q&A — RAG Pipeline")
st.caption(
    "Upload PDFs, ask questions in plain English, and get answers grounded "
    "in the source text with page-level citations."
)

# --------------------------------------------------------------------------
# Sidebar: API key + settings
# --------------------------------------------------------------------------
with st.sidebar:
    st.header("Setup")
    api_key = st.text_input(
        "Google Gemini API Key",
        type="password",
        help="Get a free key at https://aistudio.google.com/app/apikey",
    )
    st.markdown("---")
    chunk_size = st.slider("Chunk size (characters)", 500, 2000, 1000, step=100)
    chunk_overlap = st.slider("Chunk overlap", 0, 400, 150, step=50)
    top_k = st.slider("Chunks to retrieve per question (k)", 1, 8, 3)
    st.markdown("---")
    st.markdown(
        "**How it works**\n"
        "1. PDFs are split into chunks\n"
        "2. Each chunk is embedded into a vector\n"
        "3. Your question is embedded and matched to the closest chunks\n"
        "4. Gemini answers using only those chunks, and cites the page(s)"
    )

if not api_key:
    st.info("Enter your Gemini API key in the sidebar to get started. It's free at aistudio.google.com.")
    st.stop()

os.environ["GOOGLE_API_KEY"] = api_key

# --------------------------------------------------------------------------
# File upload
# --------------------------------------------------------------------------
uploaded_files = st.file_uploader(
    "Upload one or more PDFs", type=["pdf"], accept_multiple_files=True
)

if "vectorstore" not in st.session_state:
    st.session_state.vectorstore = None
if "chat_history" not in st.session_state:
    st.session_state.chat_history = []

build_col, clear_col = st.columns([1, 1])
build_clicked = build_col.button("🔨 Build knowledge base", type="primary", use_container_width=True)
clear_clicked = clear_col.button("🗑️ Clear", use_container_width=True)

if clear_clicked:
    st.session_state.vectorstore = None
    st.session_state.chat_history = []
    st.rerun()

# --------------------------------------------------------------------------
# Ingest -> chunk -> embed -> store
# --------------------------------------------------------------------------
if build_clicked:
    if not uploaded_files:
        st.warning("Upload at least one PDF first.")
    else:
        with st.spinner("Reading PDFs and building the vector index..."):
            all_docs = []
            for uf in uploaded_files:
                with tempfile.NamedTemporaryFile(delete=False, suffix=".pdf") as tmp:
                    tmp.write(uf.read())
                    tmp_path = tmp.name

                loader = PyPDFLoader(tmp_path)
                pages = loader.load()
                # tag each page with its original filename for citation
                for p in pages:
                    p.metadata["source_file"] = uf.name
                all_docs.extend(pages)
                os.unlink(tmp_path)

            splitter = RecursiveCharacterTextSplitter(
                chunk_size=chunk_size,
                chunk_overlap=chunk_overlap,
            )
            chunks = splitter.split_documents(all_docs)

            embeddings = GoogleGenerativeAIEmbeddings(model="models/embedding-001")
            vectorstore = Chroma.from_documents(chunks, embedding=embeddings)

            st.session_state.vectorstore = vectorstore
            st.session_state.num_chunks = len(chunks)
            st.session_state.chat_history = []

        st.success(f"Indexed {len(uploaded_files)} file(s) into {st.session_state.num_chunks} chunks. Ask away below.")

# --------------------------------------------------------------------------
# Q&A
# --------------------------------------------------------------------------
PROMPT_TEMPLATE = """You are a precise research assistant. Answer the question using ONLY
the context below. If the answer isn't in the context, say you don't know —
do not make anything up.

Context:
{context}

Question: {question}

Answer clearly and concisely:"""

QA_PROMPT = PromptTemplate(template=PROMPT_TEMPLATE, input_variables=["context", "question"])

if st.session_state.vectorstore is not None:
    st.markdown("---")
    st.subheader("Ask a question")
    question = st.text_input("Your question", placeholder="e.g. What was the total revenue mentioned in the report?")
    ask_clicked = st.button("Ask")

    if ask_clicked and question:
        with st.spinner("Retrieving relevant chunks and generating an answer..."):
            llm = ChatGoogleGenerativeAI(model="gemini-1.5-flash", temperature=0)
            retriever = st.session_state.vectorstore.as_retriever(search_kwargs={"k": top_k})

            qa_chain = RetrievalQA.from_chain_type(
                llm=llm,
                retriever=retriever,
                chain_type="stuff",
                chain_type_kwargs={"prompt": QA_PROMPT},
                return_source_documents=True,
            )

            result = qa_chain.invoke({"query": question})
            answer = result["result"]
            sources = result["source_documents"]

            st.session_state.chat_history.append((question, answer, sources))

    # Render chat history, most recent first
    for q, a, sources in reversed(st.session_state.chat_history):
        st.markdown(f"**Q: {q}**")
        st.write(a)
        with st.expander(f"📎 Sources ({len(sources)} chunk(s))"):
            for i, doc in enumerate(sources, 1):
                fname = doc.metadata.get("source_file", "unknown")
                page = doc.metadata.get("page", "?")
                st.markdown(f"**[{i}] {fname} — page {page}**")
                st.caption(doc.page_content[:400] + ("..." if len(doc.page_content) > 400 else ""))
        st.markdown("---")
else:
    st.info("Upload PDFs and click **Build knowledge base** to get started.")
